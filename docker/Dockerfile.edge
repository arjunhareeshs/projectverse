FROM nginx:1.27-alpine

# Each websocket holds two connections (client + upstream). The default of 1024 per
# worker is too low on small-core hosts once ~1000 students keep sockets open.
RUN sed -i 's/worker_connections\s*[0-9]*;/worker_connections 8192;/' /etc/nginx/nginx.conf \
 && sed -i 's/^worker_processes\s*auto;/worker_processes auto;\nworker_rlimit_nofile 32768;/' /etc/nginx/nginx.conf

COPY docker/nginx/edge.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
