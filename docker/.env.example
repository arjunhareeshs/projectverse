# Copy to docker/.env and fill in. This single file feeds every container.

# --- Images & release ---
IMAGE_REPO=pcdpbit
IMG_TAG=v1.1.0

# --- Public URL ---
PORT=8080                                  # host port the edge nginx listens on
PUBLIC_BASE_PATH=/verse                    # app is served at <origin>/verse
CLIENT_ORIGIN=https://pcdp.bitsathy.ac.in  # exact browser origin (CORS); http://localhost:8080 for local
TRUST_PROXY=1                              # 1 = edge nginx only; 2 if a host nginx also sits in front

# --- Scaling ---
SERVER_REPLICAS=3
DB_POOL_SERVER=15          # Prisma connections per server replica
DB_POOL_WORKER=5
POSTGRES_MAX_CONNECTIONS=200
UPLOADS_PATH=uploads_data  # named volume; set to an absolute host path (e.g. /uploads) to bind-mount

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=projectverse

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AI_API_KEY_ENCRYPTION_KEY=   # required — encrypts users' stored GROQ/NVIDIA keys; never change after launch

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- AI (optional server-level fallback; users normally bring their own keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Optional ---
GITHUB_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
